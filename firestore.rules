rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isSelfRemovalOnly() {
      // True if the only changes are members map (removing self) and optionally updatedAt.
      return (changedKeys().hasOnly(['members']) || changedKeys().hasOnly(['members', 'updatedAt']))
        && resource.data.members[request.auth.uid] != null
        && !(request.auth.uid in request.resource.data.members);
    }

    function isJoining(hid) {
      // The update only adds the user's uid to the members map
      // and doesn't change other fields except members and updatedAt.
      return (changedKeys().hasOnly(['members']) || changedKeys().hasOnly(['members', 'updatedAt']))
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members[request.auth.uid] != null
        && request.resource.data.members[request.auth.uid].role == 'member'
        && get(/databases/$(database)/documents/household_lookups/$(resource.data.inviteCode)).data.householdId == hid;
    }

    // ---- users/{uid} ----
    // Personal profile + pointer to current household. Only the user themselves
    // can read or modify their own doc.
    match /users/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (!('email' in request.resource.data) ||
            request.resource.data.email == request.auth.token.email);
    }

    // ---- households/{hid} ----
    // Shared container for staff/categories/attendance. Read/write allowed
    // for any authenticated user whose uid is listed in members.
    match /households/{hid} {
      allow read: if request.auth != null
        && resource != null
        && resource.data.members[request.auth.uid] != null;

      // Create: any authenticated user can create a household if they list
      // themselves as the owner + sole initial member.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid] != null
        && request.resource.data.members[request.auth.uid].role == 'owner';

      // Update: any current member can write data; only the owner can change
      // membership / ownership / invite code; non-owners can only self-remove
      // (leave family).
      allow update: if request.auth != null
        && (
          (resource.data.members[request.auth.uid] != null
            && (
              !changedKeys().hasAny(['members', 'ownerUid', 'inviteCode'])
              || resource.data.ownerUid == request.auth.uid
              || isSelfRemovalOnly()
            )
          )
          || isJoining(hid)
        );

      // Delete: only the owner.
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // ---- household_lookups/{inviteCode} ----
    // Small index doc that maps an invite code → householdId, so a joiner can
    // resolve a code WITHOUT being a member of the household yet (security:
    // households/{hid} would reject their read).
    match /household_lookups/{code} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // ---- archived_households/{hid} ----
    // Soft-archive doc when a user joins a different family. The original
    // owner keeps read/write access so they can restore within 30 days.
    match /archived_households/{hid} {
      allow read, update, delete: if request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Lock everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
